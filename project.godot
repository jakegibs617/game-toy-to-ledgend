; Engine configuration file.
; Toy to Legend - graffiti open-world RPG prototype (see Plan.md)

config_version=5

[application]

config/name="Toy to Legend (Prototype)"
run/main_scene="res://Scenes/PrototypeDistrict.tscn"

[autoload]

GameState="*res://Scripts/Data/game_state.gd"
WallManager="*res://Scripts/Walls/wall_manager.gd"
RivalManager="*res://Scripts/Rivals/rival_manager.gd"
CrewManager="*res://Scripts/Crew/crew_manager.gd"
TerritoryManager="*res://Scripts/Territory/territory_manager.gd"
HeatManager="*res://Scripts/Heat/heat_manager.gd"
MissionManager="*res://Scripts/Missions/mission_manager.gd"
PatrolManager="*res://Scripts/Patrols/patrol_manager.gd"
SupplyManager="*res://Scripts/Supplies/supply_manager.gd"
DialogueManager="*res://Scripts/Dialogue/dialogue_manager.gd"
StatsManager="*res://Scripts/Stats/stats_manager.gd"
TrainManager="*res://Scripts/Trains/train_manager.gd"
GalleryManager="*res://Scripts/Gallery/gallery_manager.gd"
SaveManager="*res://Scripts/SaveSystem/save_manager.gd"
Sfx="*res://Scripts/Audio/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="forward_plus"
